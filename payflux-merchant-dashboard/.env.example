# PayFlux / BasePOS payment server (testnet only)

# Port for the combined API + app (Vite runs in middleware mode).
PORT=3000

# Display conversion only: the chain always moves USDC. Change to reprice INR links.
INR_PER_USDC=85

# Public origin used when building shareable /pay/:id links. Leave blank to
# derive it from the incoming request (fine for localhost).
# APP_URL=https://your-tunnel.example

# Where links.json / settlement.json are written. Relative paths resolve from
# the directory you run the server in.
DATA_DIR=./data

# Adopt an already-deployed PaymentSettlement instead of data/settlement.json.
# Must be a real contract on Base Sepolia; the server re-reads its getters.
# SETTLEMENT_ADDRESS=0x...

# When set, POST /api/admin/settlement requires this value in x-admin-token.
# ADMIN_TOKEN=
