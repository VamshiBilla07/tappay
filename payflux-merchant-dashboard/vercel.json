{
  "version": 2,
  "framework": "vite",
  "buildCommand": "npm run vercel-build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "outputDirectory": "dist",
  "routes": [
    { "src": "/assets/(.*)", "headers": { "Cache-Control": "public, max-age=31536000, immutable" }, "dest": "/dist/assets/$1" },
    { "src": "/api/(.*)", "dest": "/api/server.ts" },
    { "src": "/(.*)", "dest": "/dist/index.html" }
  ],
  "env": {
    "SUPABASE_URL": "https://kbhffoafijmesnlfjhwb.supabase.co",
    "INR_PER_USDC": "85"
  }
}
